<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <EditText android:id="@+id/etNombre"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="Nombre" />

    <EditText android:id="@+id/etEmail"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="Email" android:inputType="textEmailAddress" />

    <Button android:id="@+id/btnGuardar"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Guardar usuario" />

    <Button android:id="@+id/btnPost"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Crear post (update)" />

    <TextView android:id="@+id/tvResultado"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="16dp" android:text="Datos en Firebase:" />
</LinearLayout>